<Window x:Class="BikeShop.Windows.ProductEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование товара"
        Width="600" Height="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Данные товара" FontSize="20" FontWeight="Bold" 
                   Foreground="{StaticResource AccentColor}" Margin="0,0,0,15"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="100"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Фото:" VerticalAlignment="Top" Margin="0,5,0,0"/>
                <StackPanel Grid.Row="0" Grid.Column="1">
                    <Image x:Name="imgProduct" Height="150" Width="225" Stretch="Uniform" 
                           HorizontalAlignment="Left" Margin="0,0,0,5"/>
                    <Button Content="Выбрать фото" Click="BtnSelectPhoto_Click" 
                            Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"/>
                </StackPanel>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Артикул (SKU):" VerticalAlignment="Center"/>
                <TextBox x:Name="txtSKU" Grid.Row="1" Grid.Column="1" Height="30" Margin="0,5"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Наименование:" VerticalAlignment="Center"/>
                <TextBox x:Name="txtName" Grid.Row="2" Grid.Column="1" Height="30" Margin="0,5"/>
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Категория:" VerticalAlignment="Center"/>
                <ComboBox x:Name="cmbCategory" Grid.Row="3" Grid.Column="1" Height="30" Margin="0,5" 
                          DisplayMemberPath="CategoryName" SelectedValuePath="CategoryID"/>
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Производитель:" VerticalAlignment="Center"/>
                <ComboBox x:Name="cmbManufacturer" Grid.Row="4" Grid.Column="1" Height="30" Margin="0,5" 
                          DisplayMemberPath="ManufacturerName" SelectedValuePath="ManufacturerID"/>
                <TextBlock Grid.Row="5" Grid.Column="0" Text="Поставщик:" VerticalAlignment="Center"/>
                <ComboBox x:Name="cmbSupplier" Grid.Row="5" Grid.Column="1" Height="30" Margin="0,5" 
                          DisplayMemberPath="SupplierName" SelectedValuePath="SupplierID"/>
                <TextBlock Grid.Row="6" Grid.Column="0" Text="Цена (руб.):" VerticalAlignment="Center"/>
                <TextBox x:Name="txtPrice" Grid.Row="6" Grid.Column="1" Height="30" Margin="0,5"/>
                <TextBlock Grid.Row="7" Grid.Column="0" Text="Скидка (%):" VerticalAlignment="Center"/>
                <TextBox x:Name="txtDiscount" Grid.Row="7" Grid.Column="1" Height="30" Margin="0,5"/>
                <TextBlock Grid.Row="8" Grid.Column="0" Text="Остаток (шт.):" VerticalAlignment="Center"/>
                <TextBox x:Name="txtQuantity" Grid.Row="8" Grid.Column="1" Height="30" Margin="0,5"/>
                <TextBlock Grid.Row="9" Grid.Column="0" Text="Ед. измерения:" VerticalAlignment="Center"/>
                <TextBox x:Name="txtUnit" Grid.Row="9" Grid.Column="1" Height="30" Margin="0,5"/>
                <TextBlock Grid.Row="10" Grid.Column="0" Text="Описание:" VerticalAlignment="Top" Margin="0,5,0,0"/>
                <TextBox x:Name="txtDescription" Grid.Row="10" Grid.Column="1" TextWrapping="Wrap" 
                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,5"/>
            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Сохранить" Width="120" Height="35" Margin="0,0,10,0" 
                    Style="{StaticResource AccentButton}" Click="BtnSave_Click"/>
            <Button Content="Отмена" Width="120" Height="35" 
                    Style="{StaticResource SecondaryButton}" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>