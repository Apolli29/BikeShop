<Window x:Class="BikeShop.Windows.OrderEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BikeShop.Windows"
        mc:Ignorable="d"
        Title="Редактирование заказа"
        Width="550" Height="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Данные заказа" FontSize="20" FontWeight="Bold" 
                   Foreground="{StaticResource AccentColor}" Margin="0,0,0,15"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Артикул:" VerticalAlignment="Center"/>
            <ComboBox x:Name="cmbProduct" Grid.Row="0" Grid.Column="1" Height="30" Margin="0,5"
                      DisplayMemberPath="SKU" SelectedValuePath="ProductID"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Статус:" VerticalAlignment="Center"/>
            <ComboBox x:Name="cmbStatus" Grid.Row="1" Grid.Column="1" Height="30" Margin="0,5">
                <ComboBoxItem Content="Новый" IsSelected="True"/>
                <ComboBoxItem Content="Завершен"/>
            </ComboBox>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Адрес ПВЗ:" VerticalAlignment="Top" Margin="0,5,0,0"/>
            <ComboBox x:Name="cmbPickupPoint" Grid.Row="2" Grid.Column="1" Height="30" Margin="0,5"
                      DisplayMemberPath="FullAddress" SelectedValuePath="PointID"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Дата заказа:" VerticalAlignment="Center"/>
            <DatePicker x:Name="dpOrderDate" Grid.Row="3" Grid.Column="1" Height="30" Margin="0,5"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Дата выдачи:" VerticalAlignment="Center"/>
            <DatePicker x:Name="dpDeliveryDate" Grid.Row="4" Grid.Column="1" Height="30" Margin="0,5"/>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Код получения:" VerticalAlignment="Center"/>
            <TextBox x:Name="txtPickupCode" Grid.Row="5" Grid.Column="1" Height="30" Margin="0,5"/>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Сохранить" Width="120" Height="35" Margin="0,0,10,0" 
                    Style="{StaticResource AccentButton}" Click="BtnSave_Click"/>
            <Button Content="Отмена" Width="120" Height="35" 
                    Style="{StaticResource SecondaryButton}" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>